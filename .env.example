# Copie para .env usando python scripts/setup_email.py (nao versionar .env)
MAESTRO_ALERT_TO=savioluz.dev@gmail.com
MAESTRO_SMTP_USER=savioluz.dev@gmail.com
MAESTRO_SMTP_HOST=smtp.gmail.com
MAESTRO_SMTP_PORT=465
MAESTRO_SMTP_SSL=true
# Senha de app do Gmail, NUNCA a senha normal da conta
MAESTRO_SMTP_PASSWORD=
# Ativar = 1; ate configurar a credencial, alertas vao para a fila local.
MAESTRO_EMAIL_ENABLED=1
